# ═══════════════════════════════════════════════════════════════════════════
# TM-X Measurement System — ค่าตั้งจริงของเครื่องนี้
# ═══════════════════════════════════════════════════════════════════════════
# ⚠ ห้าม commit ไฟล์นี้ขึ้น repo (.gitignore กันไว้แล้ว) — ตัวอย่างสำหรับแจกอยู่ที่
#   .env.example  ·  เปลี่ยนรหัสผ่านทุกตัวก่อนใช้งานจริงที่หน้างาน
#
# ── สคริปต์ที่ใช้งานจริงมี 3 ตัว ────────────────────────────────────────────
#   Backend-server/main.py              [PC] FastAPI + เสิร์ฟหน้าเว็บ
#   Backend-pc_station/send_command.py  [Pi] สั่ง TM-X ผ่าน TCP (R0/PW/T1/S0)
#   Backend-pc_station/Recieve_tm-x.py  [PC] FTP รับค่า+รูปที่ TM-X ส่งตรงมา
#
#   agent.py / ftp.py / tcp.py / TM-X_simulation/ เป็น legacy ไม่ได้ใช้แล้ว
#
# ── ตอนแยกเครื่อง (Pi + PC) ต้องก๊อปไฟล์นี้ไปทั้ง 2 เครื่อง ────────────────
#   ต้องตรงกันทั้งสองเครื่อง : AGENT_PORT
#   ต้องตั้งสวนทางกัน        : AGENT_HOST (บน PC ชี้ไป Pi)
#                              BACKEND_URL (บน Pi ชี้กลับมา PC)
# ═══════════════════════════════════════════════════════════════════════════


# ── [PC] ฐานข้อมูล ─────────────────────────────────────────────────────────
# ตอนนี้ใช้ MySQL ผ่าน Docker — docker-compose map 3307:3306 จึงใช้ DB_PORT=3307
# ตอนลงหน้างานจริง MySQL ลงเครื่องตรงเป็น Windows Service → เปลี่ยนเป็น 3306
# (ดูขั้นตอนเต็มใน DEPLOY.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pc_user
DB_PASSWORD=password
DB_NAME=tmx_db


# ── [PC] เว็บ/API ──────────────────────────────────────────────────────────
# CORS_ORIGINS — origin ที่ยอมให้เรียก API (คั่นด้วยคอมมา) · "*" = เปิดหมด
# ⚠ ห้ามปล่อยว่างหลัง "=" เด็ดขาด — จะกลายเป็น "ไม่อนุญาตใครเลย" หน้าเว็บโหลด
#   ข้อมูลไม่ได้ทั้งหมด (ต่างจากการลบทั้งบรรทัดซึ่ง fallback เป็น "*")
# ตอน deploy จริงค่อยจำกัดเป็นรายการ เช่น
#   CORS_ORIGINS=http://localhost:8000,http://192.168.10.20:8000
# หมายเหตุ: ใส่ "URL ของ backend เอง" ไม่ใช่ IP ของเครื่องที่เปิดดู และ CORS
# กันได้แค่ JavaScript ในเบราว์เซอร์ — curl/สคริปต์ยิงตรงได้อยู่ดี ไม่ใช่ระบบ
# ความปลอดภัย (ระบบนี้ยังไม่มีระบบล็อกอินเลย)
CORS_ORIGINS=*

# เพดานจำนวนแถวของรายงาน PDF/Excel — เกินแล้ว backend ปฏิเสธพร้อมบอกให้กรองก่อน
REPORT_MAX_ROWS=20000


# ── [PC ⇄ Pi] เส้นทางคุยกันระหว่าง Backend กับ send_command.py ────────────
# ⚠⚠ ห้ามใช้คำว่า "localhost" ในสองบรรทัดล่างนี้เด็ดขาด — ใช้ 127.0.0.1 เท่านั้น
#    บน Windows คำว่า localhost ถูกแปลเป็น IPv6 (::1) ก่อนเสมอ แต่ uvicorn ที่รัน
#    ด้วย --host 0.0.0.0 ผูกไว้เฉพาะ IPv4 → httpx ลอง IPv6 ก่อน รอ timeout ~2 วินาที
#    แล้วค่อยถอยมาใช้ IPv4
#    วัดจริงบนเครื่องนี้แล้ว:  localhost 2.33s  vs  127.0.0.1 0.23s  (ต่างกัน 10 เท่า)
#    ค่านี้บวกเข้าไป "ทุก request" ทำให้กด Enter ครั้งนึงช้าขึ้นหลายวินาทีโดยไม่มีสาเหตุ
#    ที่มองเห็น (ดูบรรทัด ⏱ ที่ Recieve_tm-x.py พิมพ์ออกมา)

# BACKEND_URL — [Pi อ่าน] Pi ยิง heartbeat / ถาม measured_count กลับมาที่นี่
#               แยกเครื่องแล้วต้องเป็น IP จริงของ PC เช่น http://192.168.10.20:8000
BACKEND_URL=http://127.0.0.1:8000

# AGENT_HOST  — [PC อ่าน] Backend ยิงคำสั่ง start/stop ไปหา send_command.py ที่นี่
#               แยกเครื่องแล้วต้องเป็น IP ของ Pi เช่น 192.168.10.30
AGENT_HOST=127.0.0.1

# AGENT_PORT  — [ทั้งคู่อ่าน] ต้องตรงกันเป๊ะ · PC ยิงไปพอร์ตนี้ / Pi เปิดฟังพอร์ตนี้
AGENT_PORT=9998

# ── [Pi] TM-X Controller (TCP) ─────────────────────────────────────────────
# send_command.py ต่อไปที่นี่เพื่อส่ง R0 → PW,1,<template> → T1 ต่อชิ้น → S0
# ทดสอบกับฮาร์ดแวร์จริงแล้วว่าเชื่อมต่อได้ที่ 192.168.10.11:8600
TMX_HOST=192.168.10.11
TMX_PORT=8600


# ── [PC ⇄ Pi] heartbeat ────────────────────────────────────────────────────
# HEARTBEAT_INTERVAL — [Pi อ่าน] send_command.py ยิง POST /api/heartbeat ทุกกี่วิ
# HEARTBEAT_TIMEOUT  — [PC อ่าน] เงียบเกินนี้ backend จะ mark session เป็น 'timeout'
# ⚠ INTERVAL ต้องน้อยกว่า TIMEOUT พอสมควร (ไม่เกินครึ่ง) ไม่งั้น session จะโดน
#   mark timeout ทั้งที่เครื่องยังทำงานปกติ — send_command.py เตือนให้ตอนเริ่ม
#   ถ้าตั้งค่าจนเสี่ยง
# UI_POLL_INTERVAL — [หน้าเว็บอ่าน ผ่าน GET /api/config] index.html poll
#   /api/session/state ทุกกี่วินาที · เป็นตาข่ายสำรองของ SSE และเป็นตัวที่พา
#   pi_status มาวาดชิป PI ด้วย
#
#   ⚠ ตัวนี้คือ "เพดาน" ของความไวที่ตาเห็น — ต่อให้ลด HEARTBEAT_TIMEOUT เหลือ 3
#     แต่ poll ยัง 5 วิ ก็ยังเห็นช้าได้ถึง 8 วิ (3 + 5)
#         เวลาที่เห็นบนจอ = HEARTBEAT_TIMEOUT + UI_POLL_INTERVAL (สูงสุด)
#
#   หน่วยเป็นวินาที · ลดแล้วเปลืองแค่ 1 request ต่อวินาทีต่อแท็บ (query 2 ตัว)
#   ซึ่งไม่มีนัยสำคัญบน LAN — แต่ถ้าเปิดหลายสิบแท็บพร้อมกันค่อยพิจารณาใหม่
UI_POLL_INTERVAL=1

# PI_ONLINE_TIMEOUT — [PC อ่าน] เงียบเกินนี้ = ชิป PI ขึ้น Offline + ล็อกปุ่ม Start
#   แยกจาก HEARTBEAT_TIMEOUT โดยตั้งใจ เพราะราคาของการตัดสินผิดต่างกันมาก:
#     HEARTBEAT_TIMEOUT ผิด → ฆ่า session ที่กำลังวัด ทิ้งคิว ALPL กู้ไม่ได้   🔴
#     PI_ONLINE_TIMEOUT ผิด → ชิปกระพริบ ปุ่มล็อกชั่วคราว ไม่มีอะไรเสียหาย      🟢
#   ตัวหลังจึงตั้งไวได้ ส่วนตัวแรกต้องใจเย็น
#
#   ⚠ ต้อง PI_ONLINE_TIMEOUT ≤ HEARTBEAT_TIMEOUT เสมอ ไม่งั้นจะเกิดสภาพ
#     "ชิปเขียวอยู่ทั้งที่ backend ฆ่า session ไปแล้ว"
PI_ONLINE_TIMEOUT=5

HEARTBEAT_INTERVAL=2
HEARTBEAT_TIMEOUT=5


# ── [Pi] รอยืนยันผลวัดหลังยิง T1 ───────────────────────────────────────────
# ยิง T1 แล้วไม่ไปชิ้นถัดไปทันที แต่รอดูว่า measured_count ขยับจริงไหม
# ครบ MEASURE_TIMEOUT แล้วไม่ขยับ → แจ้ง backend → หน้าเว็บเด้งถามว่าวัดต่อหรือหยุด
# จำเป็นเพราะ TM-X วัดไม่ติดบ่อย (ส่ง -9999.999 มา ซึ่งระบบไม่บันทึกให้)
MEASURE_TIMEOUT=15
MEASURE_POLL_INTERVAL=0.4


# ── [PC] FTP รับค่า+รูปจาก TM-X (Recieve_tm-x.py) ─────────────────────────
# ⚠ ส่วนนี้อยู่บน PC ไม่ใช่ Pi — TM-X ถูกตั้งให้ส่งไฟล์ตรงมาที่ PC ไม่ผ่าน Pi แล้ว
#   ต้องไปตั้งในตัว TM-X ด้วยว่าปลายทางคือ IP ของเครื่องนี้ + user/pass ตรงกับข้างล่าง
#   (ฝั่ง TM-X เป็นคนล็อกอินเข้ามา ไม่ใช่เราเลือกฝ่ายเดียว)
# พอร์ต 21: Windows bind ได้โดยไม่ต้องเป็น admin (Linux ต้อง root หรือใช้ 2121)
#           ถ้าถูก IIS FTP / FileZilla Server จองอยู่ ต้องปิดตัวนั้นก่อน
#           (net stop filezilla-server && sc config filezilla-server start= disabled)
# Firewall ต้องเปิดทั้งพอร์ต 21 และช่วง passive 60000-60100 (ตัวไฟล์วิ่งช่องนั้น)
AGENT_FTP_HOST=0.0.0.0
AGENT_FTP_PORT=21
AGENT_FTP_USER=INTERN_USER
AGENT_FTP_PASS=123456

# FORWARD_TO_BACKEND — โหมดการทำงานของ Recieve_tm-x.py
#   0 = รับอย่างเดียว: กองไฟล์ไว้ใน TEMP_IMAGE_DIR เฉยๆ ไม่ยิง backend ไม่ลบไฟล์
#       ใช้ตอนต่อ TM-X ครั้งแรกเพื่อดูว่ามันส่งอะไรมา ชื่อไฟล์หน้าตายังไง
#   1 = ใช้งานจริง: จับคู่ค่า+รูป → ถาม session → POST เข้า backend → ลบ temp
FORWARD_TO_BACKEND=1


# ── ที่เก็บรูป (ทั้งคู่อยู่บน PC) ───────────────────────────────────────────
# TEMP_IMAGE_DIR — ที่พักไฟล์ที่ TM-X ส่งมาทาง FTP ก่อนอัปโหลดเข้า backend แล้วลบทิ้ง
#                  TM-X สร้างโฟลเดอร์ย่อยเองตามวันที่ (260731/) และส่งรูปมา 2 ใบ
#                  ต่อการวัด 1 ครั้ง — ใบที่อยู่ใน HEAD-A/ ถูกข้ามและลบทิ้ง
# ALPL_IMAGE_DIR — ที่เก็บถาวร แยกโฟลเดอร์ตาม "วันที่วัด" (DD-MM-YYYY พ.ศ.)
#                  ไฟล์ .bmp ต้นทางถูกแปลงเป็น .jpg ด้วย Pillow ก่อนเซฟเสมอ
#                  เสิร์ฟให้หน้าเว็บผ่าน static mount /media/alpl
#                  ไม่ตั้งค่านี้ backend จะ default ไปที่ TM-X_Project/image_ALPL/
# ทั้งคู่เป็น path สัมพัทธ์ได้ — โค้ด resolve เทียบ "รากโปรเจกต์" ให้แล้ว ไม่ใช่
# โฟลเดอร์ที่สั่งรัน (เคยพลาดจนไฟล์ไปลงที่ Backend-server/ALPL/ มาแล้ว)
TEMP_IMAGE_DIR=./Store_image_temporary
ALPL_IMAGE_DIR=./image_ALPL

# ── ถังขยะ (กู้คืนข้อมูลที่เผลอลบ) ─────────────────────────────────────────
# ตอนลบ Measurement / Part / ข้อมูล Lookup ระบบจะเก็บแถวนั้นเป็น .json ไว้ก่อน
# (พร้อมย้ายไฟล์รูปมาเก็บคู่กัน ไม่ได้ลบทิ้ง) แล้วกู้คืนได้จากการ์ด "ถังขยะ"
# ในหน้า Edit — เกิน DELETED_RETENTION_DAYS วันแล้วจะถูกลบถาวรอัตโนมัติ
# ⚠ ห้ามชี้ DELETED_DIR ไปไว้ใต้ ALPL_IMAGE_DIR เพราะโฟลเดอร์นั้นถูกเปิดเป็น
#   static ที่ /media/alpl — รูปที่ลบไปแล้วจะยังเปิดดูได้จากเบราว์เซอร์
DELETED_DIR=./Deleted
DELETED_RETENTION_DAYS=30

# ── โหมดจำลองความผิดพลาด (mockup.py เท่านั้น — Pi.py ไม่อ่านค่าพวกนี้) ──────
# เดิม mock "ไม่เคยพลาด" จึงเทสต์เส้นทาง error ไม่ได้เลย (modal ถามผู้ใช้ ·
# ปุ่มลองใหม่ · ปุ่มรับค่าจาก Pi · การนับครบ 3 รอบแล้วหยุด) ต้องรอไปเจอของจริง
# หน้างานอย่างเดียว ซึ่งเป็นที่ที่แพงที่สุดในการเจอบั๊ก
#
#   default   ทำงานปกติ ไม่จำลอง error
#   t1        TM-X ปฏิเสธคำสั่ง T1  → ของยังอยู่ในเครื่อง → modal ปุ่ม "ลองใหม่"
#   gm        GM ไม่คืนค่าใหม่      → TM-X วัดไม่ติด      → modal ปุ่ม "ลองใหม่"
#   recieve   ค่าไม่ถึงฐานข้อมูล    → วัดแล้วแต่ไม่บันทึก → modal ปุ่ม "รับค่าจาก Pi"
# ปุ่ม ⚡ Trigger บนหน้าเว็บ — จำลองสัญญาณจาก MCU ระหว่างที่ยังต่อไม่ได้
#
# ⚠ ตั้งเป็น 0 ทันทีที่ต่อ MCU จริงแล้ว เพราะสัญญาณจาก MCU แปลว่า
#   "ชิ้นงานเข้าที่และเซนเซอร์ยืนยันแล้ว" ส่วนปุ่มแปลแค่ว่า "คนกดบอกว่าพร้อม"
#   ปล่อยเปิดไว้ = เปิดช่องให้ข้ามการตรวจของเซนเซอร์ แล้ววัดชิ้นที่ยังวางไม่เข้าที่
ALLOW_MANUAL_TRIGGER=1

# mockup.py รอสัญญาณก่อนวัดทุกชิ้นเหมือน Pi จริงไหม
#   0 = วัดเองรวดเดียว (ค่าเริ่มต้น — เทสต์เร็ว ไม่ต้องกดอะไร)
#   1 = ยืนรอทุกชิ้น ใช้ตอนอยากเทสต์ปุ่ม ⚡ Trigger บนหน้าเว็บให้ครบวง
MOCK_WAIT_TRIGGER=1

MOCK_MODE=default

# ชิ้นที่จะให้พัง (นับจาก 1) — ตั้ง 2 เพื่อให้เห็นชิ้นแรกสำเร็จก่อน จะได้เทียบกันชัด
MOCK_FAIL_PIECE=1

# พังกี่ครั้งติดกันก่อนยอมสำเร็จ — ใช้เทสต์ 2 ทางที่ต่างกันมาก
#   1  = พังครั้งเดียว กด "ลองใหม่" แล้วผ่าน → ทางที่กู้คืนได้
#   99 = พังตลอด                             → ครบ 3 รอบแล้วหยุด session
# (ไม่มีผลกับโหมด recieve เพราะเคสนั้นไม่มีการลองใหม่)
MOCK_FAIL_ROUNDS=1

# ── ถามผู้ใช้ตอนเกิดปัญหา (Pi.py และ mockup.py อ่านทั้งคู่ ต้องตรงกัน) ───────
# ตาข่ายกัน Pi ค้างถาวรตอนไม่มีใครเปิดหน้าเว็บอยู่เลย — ปกติหน้าเว็บจะกดหยุด
# ให้เองก่อนถึงเวลานี้อยู่แล้ว ตัวนี้จึงแทบไม่ได้ทำงานจริง
#
# ⚠ ต้อง **มากกว่า** MT_ANSWER_TIMEOUT ในหน้าเว็บ (60 วิ · DashboardPage.tsx)
#   ถ้าตั้งน้อยกว่าหรือเท่ากัน Pi จะยอมแพ้ไปก่อน แล้วปุ่มในโมดัลจะกดไม่ติด
#   (backend ตอบ 404 "ไม่พบคำถามค้างของ session นี้") ทั้งที่จอยังนับถอยหลังอยู่
#
# ⚠ ระยะห่างคือเวลาที่ให้คำตอบเดินทางกลับมาถึง Pi — 10 วิพอสำหรับ LAN
#   (เว็บ → backend → POST /command ไป Pi) ถ้าลดจนชิดกันจะเสี่ยงคำตอบมาไม่ทัน
ASK_USER_TIMEOUT=62

# ถามผู้ใช้ได้กี่ครั้งต่อ 1 ชิ้น ก่อนยอมแพ้แล้วหยุด session (นับใหม่ทุกชิ้น)
# ⚠ คนละตัวกับ T1_RETRY ที่เป็นการลองซ้ำอัตโนมัติของ ER,03 ในตัว trigger_tmx
MAX_ASK_USER_ROUNDS=3
