dist/
.vite/
*.local

# ── ข้อมูลรันไทม์ — สร้างใหม่ได้เอง ไม่ใช่ซอร์สโค้ด ──────────────────────
# รูปที่ Agent พักไว้ชั่วคราวก่อนอัปโหลดให้ Backend (ถูกลบทิ้งเองหลังส่งเสร็จ)
Store_image_temporary/*
!Store_image_temporary/.gitkeep
# รูปถาวรบนเครื่อง PC — เป็นข้อมูลการผลิตจริง ไม่ควรอยู่ใน repo
ALPL/
