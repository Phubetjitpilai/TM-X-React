# ═══════════════════════════════════════════════════════════════════════════
# TM-X Measurement System — ตัวอย่างไฟล์ตั้งค่า
# ═══════════════════════════════════════════════════════════════════════════
# คัดลอกเป็น ".env" ที่รากโปรเจกต์ (ระดับเดียวกับ Backend-server/) แล้วใส่ค่าจริง
# ⚠ ห้าม commit ".env" ตัวจริงขึ้น repo — เปลี่ยนรหัสผ่านทุกตัวก่อนใช้งานจริง
#
# ── สคริปต์ที่ใช้งานจริงมี 3 ตัว ────────────────────────────────────────────
#   Backend-server/main.py            รันบน PC   (FastAPI + เสิร์ฟหน้าเว็บ)
#   Backend-pc_station/send_command.py  รันบน Pi   (สั่ง TM-X ผ่าน TCP)
#   Backend-pc_station/Recieve_tm-x.py  รันบน PC   (FTP รับค่า+รูปจาก TM-X)
#
#   agent.py / ftp.py / tcp.py / TM-X_simulation/ เป็น legacy ไม่ได้ใช้แล้ว
#   ตัวแปรในไฟล์นี้จึงไม่มีอะไรที่เขียนไว้เพื่อสคริปต์พวกนั้นเลย
#
# ── ตอนแยกเครื่อง ต้องก๊อป .env ไปทั้ง 2 เครื่อง ──────────────────────────
#   แต่ละเครื่องอ่านเฉพาะตัวแปรของตัวเอง (ดูป้าย [PC] / [Pi] กำกับแต่ละหัวข้อ)
#   ตัวที่ต้องตั้งให้ "ตรงกันทั้งสองเครื่อง": AGENT_PORT
#   ตัวที่ต้องตั้ง "สวนทางกัน": AGENT_HOST (บน PC ชี้ไป Pi) กับ
#                                BACKEND_URL (บน Pi ชี้กลับมา PC)
# ═══════════════════════════════════════════════════════════════════════════


# ── [PC] ฐานข้อมูล ─────────────────────────────────────────────────────────
# dev  : MySQL ผ่าน Docker — docker-compose map 3307:3306 → ใช้ DB_PORT=3307
# จริง : MySQL ลงเครื่องตรงเป็น Windows Service → ใช้ DB_PORT=3306 (ดู DEPLOY.md)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=pc_user
DB_PASSWORD=เปลี่ยนรหัสนี้ก่อนใช้จริง
DB_NAME=tmx_db


# ── [PC] เว็บ/API ──────────────────────────────────────────────────────────
# CORS_ORIGINS — origin ที่ยอมให้เรียก API (คั่นด้วยคอมมา) ไม่ตั้ง = "*" (เปิดหมด)
# ระบบยังไม่มีระบบล็อกอิน ค่านี้จึงเป็นด่านเดียวที่จำกัดการเข้าถึงได้ระดับหนึ่ง
# ใส่ IP เครื่องที่รัน backend ด้วยถ้าจะให้ PC เครื่องอื่นในวงเปิดหน้าเว็บได้
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:5500

# เพดานจำนวนแถวของรายงาน PDF/Excel — เกินกว่านี้ backend จะปฏิเสธพร้อมบอกให้กรองก่อน
REPORT_MAX_ROWS=20000


# ── [PC ⇄ Pi] เส้นทางคุยกันระหว่าง Backend กับ send_command.py ────────────
# ⚠⚠ ห้ามใช้คำว่า "localhost" กับ 2 ค่าข้างล่างนี้ — ใช้ 127.0.0.1 เท่านั้น
#    Windows แปล localhost เป็น IPv6 (::1) ก่อน แต่ uvicorn --host 0.0.0.0 ผูก
#    เฉพาะ IPv4 → httpx รอ timeout ~2 วินาทีทุก request ก่อนถอยมาใช้ IPv4
#    วัดจริงบนเครื่องหน้างานแล้ว: localhost 2.33s vs 127.0.0.1 0.23s (ต่าง 10 เท่า)
#
# BACKEND_URL  — [Pi อ่าน] Pi ยิง heartbeat / ถาม measured_count กลับมาที่นี่
#                แยกเครื่องแล้วต้องเป็น IP จริงของ PC เช่น http://192.168.10.20:8000
BACKEND_URL=http://127.0.0.1:8000

# AGENT_HOST   — [PC อ่าน] Backend ยิงคำสั่ง start/stop ไปหา send_command.py ที่นี่
#                แยกเครื่องแล้วต้องเป็น IP ของ Pi เช่น 192.168.10.30
AGENT_HOST=127.0.0.1

# AGENT_PORT   — [ทั้งคู่อ่าน] ต้องตรงกันเป๊ะ · PC ยิงไปพอร์ตนี้ / Pi เปิดฟังพอร์ตนี้
AGENT_PORT=9998


# ── [Pi] TM-X Controller (TCP) ─────────────────────────────────────────────
# send_command.py ต่อไปที่นี่เพื่อส่ง R0 / PW / T1 / S0
TMX_HOST=192.168.10.11
TMX_PORT=8600


# ── [PC ⇄ Pi] heartbeat ────────────────────────────────────────────────────
# HEARTBEAT_INTERVAL — ความถี่ที่ send_command.py ยิง POST /api/heartbeat (วินาที)
# HEARTBEAT_TIMEOUT  — [PC อ่าน] เงียบเกินนี้ backend จะ mark session เป็น 'timeout'
# ⚠ INTERVAL ต้องน้อยกว่า TIMEOUT พอสมควร (แนะนำไม่เกินครึ่ง) ไม่งั้น session
#   จะโดน mark timeout ทั้งที่เครื่องยังทำงานปกติ — send_command.py จะเตือนตอนเริ่ม
#   ถ้าตั้งค่าจนเสี่ยง
HEARTBEAT_INTERVAL=5
HEARTBEAT_TIMEOUT=15


# ── [Pi] รอยืนยันผลวัดหลังยิง T1 ───────────────────────────────────────────
# ยิง T1 แล้วไม่ไปชิ้นถัดไปทันที แต่รอดูว่า measured_count ขยับจริงไหม
# ครบ MEASURE_TIMEOUT แล้วไม่ขยับ → แจ้ง backend → หน้าเว็บเด้งถามว่าวัดต่อหรือหยุด
# (จำเป็นเพราะ TM-X วัดไม่ติดบ่อย ส่ง -9999.999 มา ซึ่งระบบไม่บันทึกให้)
MEASURE_TIMEOUT=15
MEASURE_POLL_INTERVAL=0.4


# ── [PC] FTP รับค่า+รูปจาก TM-X (Recieve_tm-x.py) ─────────────────────────
# ⚠ ส่วนนี้อยู่บน PC ไม่ใช่ Pi — TM-X ถูกตั้งให้ส่งไฟล์ตรงมาที่ PC ไม่ผ่าน Pi แล้ว
# ต้องไปตั้งใน TM-X ด้วยว่าปลายทางคือ IP ของเครื่องนี้ + user/pass ตรงกับข้างล่าง
# พอร์ต 21: Windows bind ได้โดยไม่ต้องเป็น admin (Linux ต้อง root หรือใช้ 2121)
#           ถ้าพอร์ตถูก IIS FTP / FileZilla Server จองอยู่ ต้องปิดตัวนั้นก่อน
# Firewall ต้องเปิดทั้งพอร์ต 21 และช่วง passive 60000-60100 (ตัวไฟล์วิ่งช่องนั้น)
AGENT_FTP_HOST=0.0.0.0
AGENT_FTP_PORT=21
AGENT_FTP_USER=INTERN_USER
AGENT_FTP_PASS=เปลี่ยนรหัสนี้ก่อนใช้จริง

# FORWARD_TO_BACKEND — โหมดการทำงานของ Recieve_tm-x.py
#   0 = รับอย่างเดียว: กองไฟล์ไว้ใน TEMP_IMAGE_DIR เฉยๆ ไม่ยิง backend ไม่ลบไฟล์
#       ใช้ตอนต่อ TM-X ครั้งแรกเพื่อดูว่ามันส่งอะไรมา ชื่อไฟล์หน้าตายังไง
#   1 = ใช้งานจริง: จับคู่ค่า+รูป → ถาม session → POST เข้า backend → ลบ temp
FORWARD_TO_BACKEND=1


# ── ที่เก็บรูป ──────────────────────────────────────────────────────────────
# TEMP_IMAGE_DIR  — [PC] ที่พักไฟล์ที่ TM-X ส่งมาทาง FTP ก่อนอัปโหลดเข้า backend
#                   แล้วลบทิ้ง · TM-X สร้างโฟลเดอร์ย่อยเองตามวันที่ (260731/)
#                   และส่งรูปมา 2 ใบต่อการวัด 1 ครั้ง (ใบใน HEAD-A/ ถูกข้าม+ลบ)
# ALPL_IMAGE_DIR  — [PC] ที่เก็บถาวร แยกโฟลเดอร์ตามวันที่วัด (DD-MM-YYYY พ.ศ.)
#                   ไฟล์ .bmp ต้นทางถูกแปลงเป็น .jpg ด้วย Pillow ก่อนเซฟเสมอ
#                   เสิร์ฟให้หน้าเว็บผ่าน static mount /media/alpl
# ทั้งคู่เป็น path สัมพัทธ์ได้ — โค้ด resolve เทียบ "รากโปรเจกต์" ให้แล้ว
# ไม่ใช่โฟลเดอร์ที่สั่งรัน (เคยพลาดจนไฟล์ไปลงผิดที่มาแล้ว)
TEMP_IMAGE_DIR=./Store_image_temporary
ALPL_IMAGE_DIR=./image_ALPL

# ── ถังขยะ (กู้คืนข้อมูลที่เผลอลบ) ─────────────────────────────────────────
# ตอนลบ Measurement / Part / ข้อมูล Lookup ระบบจะเก็บแถวนั้นเป็น .json ไว้ก่อน
# (พร้อมย้ายไฟล์รูปมาเก็บคู่กัน ไม่ได้ลบทิ้ง) แล้วกู้คืนได้จากการ์ด "ถังขยะ"
# ในหน้า Edit — เกิน DELETED_RETENTION_DAYS วันแล้วจะถูกลบถาวรอัตโนมัติ
# ⚠ ห้ามชี้ DELETED_DIR ไปไว้ใต้ ALPL_IMAGE_DIR เพราะโฟลเดอร์นั้นถูกเปิดเป็น
#   static ที่ /media/alpl — รูปที่ลบไปแล้วจะยังเปิดดูได้จากเบราว์เซอร์
DELETED_DIR=./Deleted
DELETED_RETENTION_DAYS=30
